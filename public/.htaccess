# Apache (e.g. o2switch). Ignored by other static hosts.

# Server-side redirect of the root to the default locale (the meta-refresh page is a fallback).
RedirectMatch 301 ^/$ /fr/

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/xml text/xml text/plain
</IfModule>

<IfModule mod_headers.c>
  # Build assets (/_astro/) are fingerprinted and never change.
  <If "%{REQUEST_URI} =~ m#^/_astro/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  # Pages must revalidate so a new deploy is picked up immediately.
  <FilesMatch "\.(html|xml)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_mime.c>
  AddType font/woff2 .woff2
</IfModule>
