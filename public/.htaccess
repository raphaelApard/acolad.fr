<IfModule pagespeed_module>
ModPagespeed on
ModPagespeedRewriteLevel PassThrough
ModPagespeedEnableFilters add_head,extend_cache
</IfModule>

RewriteEngine on
RewriteCond %{HTTP_HOST} ^acolad\.fr$
RewriteRule ^/?$ "https\:\/\/www\.acolad\.fr\/" [R=301,L]

# Redirections explicites des anciennes URLs
RedirectMatch 301 ^/saclay/?$ https://www.acolad.fr/
RedirectMatch 301 ^/syndex/?$ https://www.acolad.fr/
RedirectMatch 301 ^/de-boeck/?$ https://www.acolad.fr/
RedirectMatch 301 ^/muzeopro/?$ https://www.acolad.fr/
RedirectMatch 301 ^/cplus2b/?$ https://www.acolad.fr/
RedirectMatch 301 ^/meettotravel/?$ https://www.acolad.fr/
RedirectMatch 301 ^/challenge-one/?$ https://www.acolad.fr/
RedirectMatch 301 ^/audio-analog/?$ https://www.acolad.fr/
RedirectMatch 301 ^/contact/?$ https://www.acolad.fr/
RedirectMatch 301 ^/equipe/?$ https://www.acolad.fr/
RedirectMatch 301 ^/mentions-legales/?$ https://www.acolad.fr/
RedirectMatch 301 ^/politique-confidentialite/?$ https://www.acolad.fr/
RedirectMatch 301 ^/projets/?$ https://www.acolad.fr/
RedirectMatch 301 ^/services/?$ https://www.acolad.fr/

# Former sitemap files, possibly already submitted to search engines
RedirectMatch 301 ^/sitemap-(index|0)\.xml$ https://www.acolad.fr/sitemap.xml

<Files 403.shtml>
order allow,deny
allow from all
</Files>
