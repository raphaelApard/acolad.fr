---
import { Font } from 'astro:assets';
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { alternates, defaultLang, langs, type Lang, type PageId, type SiteContent } from '../site';

interface Props {
  site: SiteContent;
  title: string;
  description: string;
  /** The page being shown. Error pages have none: they are kept out of search results,
      without canonical or alternates. */
  page?: PageId;
  /** Pages that already are a call to action skip the band above the footer. */
  hideCta?: boolean;
  /** Structured data of the page. */
  jsonLd?: object;
}

const { site, title, description, page, hideCta, jsonLd } = Astro.props;
const { lang } = site;
const url = (l: Lang) => new URL(alternates(page ?? 'home')[l], Astro.site).href;
const ogLocale = { fr: 'fr_FR', en: 'en_GB' }[lang];
// "<" escaped so the JSON can never close the script element.
const json = jsonLd && JSON.stringify(jsonLd).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <Font cssVariable="--font-inter" preload />
    <Font cssVariable="--font-space-grotesk" preload />
    <Font cssVariable="--font-jetbrains" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {
      page ? (
        <>
          <link rel="canonical" href={url(lang)} />
          {langs.map((l) => <link rel="alternate" hreflang={l} href={url(l)} />)}
          <link rel="alternate" hreflang="x-default" href={url(defaultLang)} />
        </>
      ) : (
        <meta name="robots" content="noindex" />
      )
    }
    <link rel="sitemap" href="/sitemap.xml" />
    <meta name="theme-color" content="#ffffff" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {page && <meta property="og:url" content={url(lang)} />}
    <meta property="og:locale" content={ogLocale} />
    <script>
      import '../scripts/matomo';
    </script>
    {json && <script type="application/ld+json" set:html={json} />}
  </head>
  <body>
    <a class="skip-link" href="#content">{site.ui.skipLink}</a>
    <SiteHeader site={site} page={page} />
    <main id="content">
      <slot />
    </main>
    <SiteFooter site={site} hideCta={hideCta} />
  </body>
</html>
