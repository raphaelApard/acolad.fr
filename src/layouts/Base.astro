---
import { Font, getImage } from 'astro:assets';
import '../styles/global.css';
import { getAbsoluteLocaleUrl } from 'astro:i18n';
import { langs } from '../content';
import { asset } from '../lib/images';
import type { Content } from '../content/types';

interface Props {
  content: Content;
}

const { content } = Astro.props;
const { lang, title, description } = content.meta;
const canonical = getAbsoluteLocaleUrl(lang);
const ogLocale = { fr: 'fr_FR', en: 'en_GB' }[lang];
const ogImage = await getImage({ src: asset(content.hero.portrait.src), format: 'jpg', width: 468 });
const portrait = new URL(ogImage.src, Astro.site).href;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <Font cssVariable="--font-schibsted" preload />
    <Font cssVariable="--font-jetbrains" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {langs.map((l) => <link rel="alternate" hreflang={l} href={getAbsoluteLocaleUrl(l)} />)}
    <link rel="alternate" hreflang="x-default" href={getAbsoluteLocaleUrl('fr')} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#F4F5F7" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:image" content={portrait} />
    {import.meta.env.PROD && (
      <>
        <!-- Matomo -->
        <script is:inline>
          var _paq = window._paq = window._paq || [];
          /* tracker methods like "setCustomDimension" should be called before "trackPageView" */
          _paq.push(['trackPageView']);
          _paq.push(['enableLinkTracking']);
          (function() {
            var u="https://stats.acolad.net/";
            _paq.push(['setTrackerUrl', u+'matomo.php']);
            _paq.push(['setSiteId', '8']);
            var d=document, g=d.createElement('script'), s=d.getElementsByTagName('script')[0];
            g.async=true; g.src=u+'matomo.js'; s.parentNode.insertBefore(g,s);
          })();
        </script>
        <!-- End Matomo Code -->
      </>
    )}
  </head>
  <body>
    <slot />
  </body>
</html>
