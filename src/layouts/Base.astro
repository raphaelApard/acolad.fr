---
import '@fontsource-variable/schibsted-grotesk';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
import '../styles/global.css';
import { getAbsoluteLocaleUrl } from 'astro:i18n';
import { langs } from '../content';
import type { Content } from '../content/types';

interface Props {
  content: Content;
}

const { content } = Astro.props;
const { lang, title, description } = content.meta;
const canonical = getAbsoluteLocaleUrl(lang);
const ogLocale = { fr: 'fr_FR', en: 'en_GB' }[lang];
const portrait = new URL(content.hero.portrait.src, Astro.site).href;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {langs.map((l) => <link rel="alternate" hreflang={l} href={getAbsoluteLocaleUrl(l)} />)}
    <link rel="alternate" hreflang="x-default" href={getAbsoluteLocaleUrl('fr')} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#F4F5F7" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:image" content={portrait} />
  </head>
  <body>
    <slot />
  </body>
</html>
