---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { getContent, langs } from '../content';
import type { Content } from '../content/types';
import MenuIcon from './icons/Menu.astro';
import CloseIcon from './icons/Close.astro';

interface Props {
  content: Content;
}

const { content } = Astro.props;
const { lang } = content.meta;
const { ui, nav, hero } = content;
---

<span class="sticky-sentinel" data-header-sentinel aria-hidden="true"></span>
<header id="top" class="site-header" data-header>
  <div class="wrap bar">
    <a class="brand" href={getRelativeLocaleUrl(lang)}>{hero.name}</a>

    <nav id="main-nav" class="nav" aria-label={ui.mainNav} data-menu>
      <ul class="list-reset nav-list">
        {nav.map((item) => <li><a href={`#${item.id}`}>{item.label}</a></li>)}
      </ul>
    </nav>

    <div class="actions">
      <div role="group" aria-label={ui.languageSwitch} class="lang-switch" data-lang-switch>
        {
          langs.map((l) => (
            <a
              href={getRelativeLocaleUrl(l)}
              hreflang={l}
              lang={l}
              aria-current={l === lang ? 'page' : undefined}
            >
              <span aria-hidden="true">{l.toUpperCase()}</span>
              <span class="sr-only">{getContent(l).meta.languageName}</span>
            </a>
          ))
        }
      </div>
      <button
        type="button"
        class="menu-button"
        aria-expanded="false"
        aria-controls="main-nav"
        aria-label={ui.openMenu}
        data-menu-button
        data-label-open={ui.openMenu}
        data-label-close={ui.closeMenu}
      >
        <span class="icon-open"><MenuIcon /></span>
        <span class="icon-close"><CloseIcon /></span>
      </button>
    </div>
  </div>
</header>

<script>
  // The header is sticky; once the page leaves the top it shrinks (see .site-header[data-stuck]).
  const header = document.querySelector<HTMLElement>('[data-header]');
  const sentinel = document.querySelector('[data-header-sentinel]');
  if (header && sentinel) {
    new IntersectionObserver(([entry]) => header.toggleAttribute('data-stuck', !entry!.isIntersecting)).observe(sentinel);
  }

  // Remember an explicit language choice: the server then stops sending
  // English-speaking browsers from / to /en/ (see public/.htaccess).
  for (const link of document.querySelectorAll<HTMLAnchorElement>('[data-lang-switch] a')) {
    link.addEventListener('click', () => {
      document.cookie = `lang=${link.hreflang}; path=/; max-age=31536000; samesite=lax; secure`;
    });
  }

  const button = document.querySelector<HTMLButtonElement>('[data-menu-button]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');

  if (button && menu) {
    const setOpen = (open: boolean) => {
      button.setAttribute('aria-expanded', String(open));
      button.setAttribute('aria-label', (open ? button.dataset.labelClose : button.dataset.labelOpen) ?? '');
      menu.toggleAttribute('data-open', open);
    };

    button.addEventListener('click', () => setOpen(button.getAttribute('aria-expanded') !== 'true'));

    menu.addEventListener('click', (event) => {
      if ((event.target as Element).closest('a')) setOpen(false);
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && button.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        button.focus();
      }
    });

    matchMedia('(min-width: 961px)').addEventListener('change', (event) => {
      if (event.matches) setOpen(false);
    });
  }
</script>

<style>
  /* Marks the top of the page: out of view means the header is stuck. */
  .sticky-sentinel {
    position: absolute;
    top: 0;
    left: 0;
    width: 1px;
    height: 1px;
    pointer-events: none;
  }

  /* The header keeps its full height in the flow (no layout shift) and sticks with its top
     part above the viewport, so only --header-stuck-height stays visible. Once stuck, the
     top padding moves the content into that visible part. */
  .site-header {
    position: relative;
    z-index: 5;
    border-bottom: 1px solid var(--color-border);
    background: var(--color-bg);
    transition: box-shadow 0.2s ease;
  }

  /* Without JS nothing marks it stuck, and the mobile nav wraps under the bar: keep it static. */
  :global(.js) .site-header {
    position: sticky;
    top: calc(var(--header-stuck-height) - var(--header-height));
  }

  .site-header[data-stuck] {
    box-shadow: 0 6px 18px rgb(15 18 23 / 0.06);
  }

  .bar {
    min-height: var(--header-height);
    padding-top: 0;
    transition: padding-top 0.2s ease;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .site-header[data-stuck] .bar {
    padding-top: calc(var(--header-height) - var(--header-stuck-height));
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header,
    .bar {
      transition: none;
    }
  }

  .brand {
    font-weight: 700;
    font-size: 18px;
    letter-spacing: -0.01em;
    text-decoration: none;
  }

  .nav-list {
    display: flex;
    gap: 32px;
    font-size: 15px;
    font-weight: 500;
  }

  .nav-list a {
    text-decoration: none;
  }

  .actions {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  /* Compact two-way switch: a pill marks the current language and slides towards the other
     one on hover, previewing the change. Assumes exactly two languages. */
  .lang-switch {
    position: relative;
    display: inline-grid;
    grid-auto-columns: 1fr;
    grid-auto-flow: column;
    padding: 2px;
    border-radius: 999px;
    background: var(--color-border);
  }

  .lang-switch::before {
    content: '';
    position: absolute;
    top: 2px;
    bottom: 2px;
    left: 2px;
    width: calc(50% - 2px);
    border-radius: 999px;
    background: var(--color-ink);
    transition: transform 0.2s ease;
  }

  .lang-switch:has(a:last-child[aria-current])::before,
  .lang-switch:has(a:first-child[aria-current]):has(a:last-child:hover)::before {
    transform: translateX(100%);
  }

  .lang-switch:has(a:last-child[aria-current]):has(a:first-child:hover)::before {
    transform: none;
  }

  .lang-switch a {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 34px;
    min-height: 26px;
    border-radius: 999px;
    color: var(--color-text-muted);
    font: 500 12px var(--font-mono);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .lang-switch a[aria-current],
  .lang-switch a:not([aria-current]):hover {
    color: var(--color-surface);
  }

  .lang-switch:has(a:not([aria-current]):hover) a[aria-current] {
    color: var(--color-text-muted);
  }

  .lang-switch a:focus-visible {
    outline-offset: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .lang-switch::before,
    .lang-switch a {
      transition: none;
    }
  }

  .menu-button {
    display: none;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--color-ink);
    cursor: pointer;
  }

  .icon-open,
  .icon-close {
    display: inline-flex;
  }

  .menu-button[aria-expanded='true'] .icon-open,
  .menu-button[aria-expanded='false'] .icon-close {
    display: none;
  }

  @media (max-width: 960px) {
    .bar {
      gap: 12px;
    }

    .brand {
      font-size: 17px;
    }

    /* Without JS the nav stays visible and wraps under the bar. */
    .bar {
      flex-wrap: wrap;
    }

    .nav {
      order: 3;
      flex-basis: 100%;
      padding-bottom: 12px;
    }

    .nav-list {
      flex-wrap: wrap;
      gap: 0 20px;
    }

    .nav-list a {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
    }

    :global(.js) .bar {
      flex-wrap: nowrap;
    }

    :global(.js) .menu-button {
      display: inline-flex;
    }

    :global(.js) .nav {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      padding: 8px var(--gutter-mobile) 20px;
      border-bottom: 1px solid var(--color-border);
      background: var(--color-bg);
      box-shadow: 0 12px 24px rgb(15 18 23 / 0.08);
    }

    :global(.js) .nav[data-open] {
      display: block;
    }

    :global(.js) .nav-list {
      flex-direction: column;
      font-size: 19px;
      font-weight: 600;
    }

    :global(.js) .nav-list li + li {
      border-top: 1px solid var(--color-border);
    }

    :global(.js) .nav-list a {
      display: flex;
      min-height: 52px;
    }
  }
</style>
