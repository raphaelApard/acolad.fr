---
// Square white tile holding a company logo, whatever its aspect ratio.
// Decorative: the company name is always printed next to it.
import { Image } from 'astro:assets';
import { asset } from '../lib/images';

interface Props {
  src: string;
  /** Tile side in px; the logo fits inside with an 8px inner margin. */
  size?: number;
  class?: string;
}

const { src, size = 56, class: className } = Astro.props;
const image = asset(src);
const inner = size - 16;
// Fit the longest side to the inner box so the tile never stretches.
const scale = inner / Math.max(image.width, image.height);
const width = Math.round(image.width * scale);
const height = Math.round(image.height * scale);
---

<span class:list={['tile', className]} style={`--tile: ${size}px`}>
  <Image src={image} alt="" width={width} height={height} densities={[1, 2]} />
</span>

<style>
  .tile {
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: var(--tile);
    height: var(--tile);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
  }

  img {
    display: block;
    max-width: calc(var(--tile) - 16px);
    max-height: calc(var(--tile) - 16px);
    width: auto;
    height: auto;
  }
</style>
