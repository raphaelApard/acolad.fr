---
import { business } from '../content/business';
import { href, serviceIds, type PageId, type SiteContent } from '../site';
import Arrow from './Arrow.astro';
import Logo from './Logo.astro';

interface Props {
  site: SiteContent;
  /** Pages that already are a call to action (contact, legal, errors) skip the band. */
  hideCta?: boolean;
}

const { site, hideCta = false } = Astro.props;
const { lang, footer, cta } = site;
// The site is static: the closing year is the build year, so it moves on with the next deploy.
const years = `${business.foundingDate.slice(0, 4)}–${new Date().getFullYear()}`;
const company: { id: PageId; label: string }[] = [
  { id: 'work', label: site.nav.work },
  { id: 'about', label: site.nav.about },
  { id: 'contact', label: site.nav.contact },
  { id: 'legal', label: site.legal.h1 },
];
---

{
  !hideCta && (
    <section class="cta-band">
      <div class="container">
        <div class="copy stack">
          <h2 class="title">{cta.title}</h2>
          <p>{cta.text}</p>
        </div>
        <a class="btn btn--light" href={href('contact', lang)}>
          {cta.button}
          <Arrow />
        </a>
      </div>
    </section>
  )
}
<footer class="site-footer on-dark">
  <div class="container">
    <div class="grid columns">
      <div class="about stack">
        <a class="brand" href={href('home', lang)} aria-label={site.ui.homeLink}>
          <Logo outlined />
          <span class="brand-name">{site.siteName}</span>
        </a>
        <p>{footer.tagline}</p>
      </div>
      <nav aria-label={footer.servicesTitle}>
        <span class="label">{footer.servicesTitle}</span>
        {serviceIds.map((id) => <a href={href(id, lang)}>{site.services[id].name}</a>)}
      </nav>
      <nav aria-label={footer.companyTitle}>
        <span class="label">{footer.companyTitle}</span>
        {company.map(({ id, label }) => <a href={href(id, lang)}>{label}</a>)}
      </nav>
      <div class="contact">
        <span class="label">{footer.contactTitle}</span>
        <a href={`mailto:${business.email}`}>{business.email}</a>
        <a href={`tel:${business.telephone}`}>{business.telephoneDisplay}</a>
        <span>{footer.location}</span>
      </div>
    </div>
    <div class="bottom">
      <span>© {years} {footer.copyright}</span>
      <span class="note">{footer.note}</span>
    </div>
  </div>
</footer>
