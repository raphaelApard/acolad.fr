---
import type { Content } from '../content/types';
import SectionTitle from './SectionTitle.astro';

interface Props {
  content: Content;
}

const { domains } = Astro.props.content;
---

<section id="domaines" aria-labelledby="t-domains" class="domains">
  <div class="wrap section split">
    <SectionTitle id="t-domains" number={domains.number} title={domains.title} />
    <ul class="list-reset items">
      {domains.items.map((item) => <li>{item}</li>)}
    </ul>
  </div>
</section>

<style>
  .domains {
    border-top: 1px solid var(--color-border);
  }

  .section {
    padding-top: var(--section-pad-desktop);
    padding-bottom: var(--section-pad-desktop);
  }

  .split {
    display: grid;
    grid-template-columns: 340px minmax(0, 1fr);
    gap: 64px;
  }

  .items {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 48px 40px;
  }

  .items li {
    padding-top: 20px;
    border-top: 2px solid var(--color-ink);
    font-size: 22px;
    line-height: 1.3;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  @media (max-width: 960px) {
    .section {
      padding-top: var(--section-pad-mobile);
      padding-bottom: var(--section-pad-mobile);
    }

    .split {
      grid-template-columns: 1fr;
      gap: 32px;
    }

    .items {
      grid-template-columns: 1fr;
      gap: 0;
    }

    .items li {
      padding: 18px 0;
      border-top: 1px solid var(--color-border-strong);
      font-size: 19px;
      letter-spacing: 0;
    }

    .items li:first-child {
      border-top: 2px solid var(--color-ink);
    }

    .items li:last-child {
      border-bottom: 1px solid var(--color-border-strong);
    }
  }
</style>
