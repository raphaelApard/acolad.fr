---
// Error page served by Apache for unknown URLs, one per locale (see `ErrorDocument` in
// public/.htaccess). Asset and link URLs are absolute, so it renders at any depth.
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import { Image } from 'astro:assets';
import ArrowRight from './icons/ArrowRight.astro';
import { asset } from '../lib/images';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { getContent, langs } from '../content';
import type { Lang } from '../content/types';

interface Props {
  lang: Lang;
}

const content = getContent(Astro.props.lang);
const { notFound, ui, hero } = content;
// The language switch leads to each home page.
const homes = Object.fromEntries(langs.map((l) => [l, getRelativeLocaleUrl(l)])) as Record<Lang, string>;
---

<Base content={content} title={`${notFound.title} — ${hero.name}`} noindex>
  <a class="skip-link" href="#content">{ui.skipLink}</a>
  <Header content={content} alternates={homes} />
  <main id="content" class="not-found">
    <div class="copy">
      <p class="label code">{notFound.code}</p>
      <h1>{notFound.title}</h1>
      <p class="text">{notFound.text}</p>
      <a class="cta" href={homes[content.meta.lang]}>{notFound.cta}<ArrowRight /></a>
    </div>
    <Image
      class="picture"
      src={asset(notFound.image.src)}
      alt={notFound.image.alt}
      widths={[480, 704, 960, 1408]}
      sizes="(max-width: 960px) 100vw, 50vw"
      loading="eager"
      fetchpriority="high"
    />
  </main>
  <Footer content={content} />
</Base>

<style>
  /* Desktop: two halves. The text keeps the page grid's left edge; the picture fills the
     whole right half, edge to edge and top to bottom, cropped around the road sign. */
  .not-found {
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: 600px;
  }

  .copy {
    align-self: center;
    padding: 96px 64px 128px max(var(--gutter-desktop), calc((100vw - var(--container-max)) / 2 + var(--gutter-desktop)));
  }

  .picture {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 30% center;
  }

  .code {
    color: var(--color-accent);
  }

  h1 {
    max-width: 14em;
    margin: 16px 0 0;
    font-size: 56px;
    line-height: 1;
    font-weight: 800;
    letter-spacing: -0.04em;
  }

  .text {
    max-width: 36em;
    margin: 24px 0 0;
    font-size: 19px;
    line-height: 1.6;
    color: var(--color-text);
  }

  .cta {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    min-height: 56px;
    margin-top: 40px;
    padding: 0 28px;
    border-radius: var(--radius-sm);
    background: var(--color-accent);
    color: var(--color-surface);
    font-size: 17px;
    font-weight: 600;
    text-decoration: none;
  }

  .cta:hover {
    background: var(--color-ink);
    color: var(--color-surface);
  }

  @media (max-width: 960px) {
    /* Mobile: text, then the picture across the full width, uncropped. */
    .not-found {
      grid-template-columns: 1fr;
      min-height: 0;
    }

    .copy {
      padding: 48px var(--gutter-mobile) 40px;
    }

    .picture {
      height: auto;
    }

    h1 {
      font-size: 40px;
    }

    .text {
      font-size: 17px;
    }
  }
</style>
