---
// Error page served by Apache for unknown URLs, one per locale (see `ErrorDocument` in
// public/.htaccess). Asset and link URLs are absolute, so it renders at any depth.
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import ArrowRight from './icons/ArrowRight.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { getContent, langs } from '../content';
import type { Lang } from '../content/types';

interface Props {
  lang: Lang;
}

const content = getContent(Astro.props.lang);
const { notFound, ui, hero } = content;
// The language switch leads to each home page.
const homes = Object.fromEntries(langs.map((l) => [l, getRelativeLocaleUrl(l)])) as Record<Lang, string>;
---

<Base content={content} title={`${notFound.title} — ${hero.name}`} noindex>
  <a class="skip-link" href="#content">{ui.skipLink}</a>
  <Header content={content} alternates={homes} />
  <main id="content" class="wrap not-found">
    <p class="label code">{notFound.code}</p>
    <h1>{notFound.title}</h1>
    <p class="text">{notFound.text}</p>
    <a class="cta" href={homes[content.meta.lang]}>{notFound.cta}<ArrowRight /></a>
  </main>
  <Footer content={content} />
</Base>

<style>
  .not-found {
    padding-top: 120px;
    padding-bottom: 160px;
  }

  .code {
    color: var(--color-accent);
  }

  h1 {
    max-width: 14em;
    margin: 16px 0 0;
    font-size: 64px;
    line-height: 1;
    font-weight: 800;
    letter-spacing: -0.04em;
  }

  .text {
    max-width: 36em;
    margin: 24px 0 0;
    font-size: 19px;
    line-height: 1.6;
    color: var(--color-text);
  }

  .cta {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    min-height: 56px;
    margin-top: 40px;
    padding: 0 28px;
    border-radius: var(--radius-sm);
    background: var(--color-accent);
    color: var(--color-surface);
    font-size: 17px;
    font-weight: 600;
    text-decoration: none;
  }

  .cta:hover {
    background: var(--color-ink);
    color: var(--color-surface);
  }

  @media (max-width: 960px) {
    .not-found {
      padding-top: 64px;
      padding-bottom: 96px;
    }

    h1 {
      font-size: 40px;
    }

    .text {
      font-size: 17px;
    }
  }
</style>
