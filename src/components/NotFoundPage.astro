---
// Error page served by Apache for unknown URLs, one per locale (see `ErrorDocument` in
// public/.htaccess). Asset and link URLs are absolute, so it renders at any depth.
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import { Image } from 'astro:assets';
import ArrowRight from './icons/ArrowRight.astro';
import { asset } from '../lib/images';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { getContent, langs } from '../content';
import type { Lang } from '../content/types';

interface Props {
  lang: Lang;
}

const content = getContent(Astro.props.lang);
const { notFound, ui, hero } = content;
// The language switch leads to each home page.
const homes = Object.fromEntries(langs.map((l) => [l, getRelativeLocaleUrl(l)])) as Record<Lang, string>;
---

<Base content={content} title={`${notFound.title} — ${hero.name}`} noindex>
  <a class="skip-link" href="#content">{ui.skipLink}</a>
  <Header content={content} alternates={homes} />
  <main id="content" class="wrap not-found">
    <div class="copy">
      <p class="label code">{notFound.code}</p>
      <h1>{notFound.title}</h1>
      <p class="text">{notFound.text}</p>
      <a class="cta" href={homes[content.meta.lang]}>{notFound.cta}<ArrowRight /></a>
    </div>
    <Image
      class="picture"
      src={asset(notFound.image.src)}
      alt={notFound.image.alt}
      widths={[480, 704, 960, 1408]}
      sizes="(max-width: 960px) calc(100vw - 40px), 640px"
      loading="eager"
      fetchpriority="high"
    />
  </main>
  <Footer content={content} />
</Base>

<style>
  .not-found {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
    gap: 64px;
    align-items: center;
    padding-top: 96px;
    padding-bottom: 128px;
  }

  .picture {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }

  .code {
    color: var(--color-accent);
  }

  h1 {
    max-width: 14em;
    margin: 16px 0 0;
    font-size: 56px;
    line-height: 1;
    font-weight: 800;
    letter-spacing: -0.04em;
  }

  .text {
    max-width: 36em;
    margin: 24px 0 0;
    font-size: 19px;
    line-height: 1.6;
    color: var(--color-text);
  }

  .cta {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    min-height: 56px;
    margin-top: 40px;
    padding: 0 28px;
    border-radius: var(--radius-sm);
    background: var(--color-accent);
    color: var(--color-surface);
    font-size: 17px;
    font-weight: 600;
    text-decoration: none;
  }

  .cta:hover {
    background: var(--color-ink);
    color: var(--color-surface);
  }

  @media (max-width: 960px) {
    .not-found {
      grid-template-columns: 1fr;
      gap: 40px;
      padding-top: 48px;
      padding-bottom: 72px;
    }

    h1 {
      font-size: 40px;
    }

    .text {
      font-size: 17px;
    }
  }
</style>
