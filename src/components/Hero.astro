---
import type { Content } from '../content/types';
import ArrowRight from './icons/ArrowRight.astro';
import Profiles from './Profiles.astro';

interface Props {
  content: Content;
}

const { hero, links, ui, meta } = Astro.props.content;
const [firstName, ...lastNames] = hero.name.split(' ');
const { facts } = hero;
// French typography puts a space before the colon.
const colon = meta.lang === 'fr' ? ' : ' : ': ';
---

<section aria-labelledby="hero-title" class:list={['wrap', 'hero', { 'has-facts': facts }]}>
  <div class="text">
    <p class="mono info">{hero.info.join(' · ')}</p>
    <!-- The role is part of the h1: it carries the query the page targets, not only the name. -->
    <h1 id="hero-title" class="heading">
      <span class="name">{firstName}<br />{lastNames.join(' ')}</span><span class="sr-only">, </span>
      <span class="title">{hero.title}</span>
    </h1>
    <p class="lead"><strong>{hero.leadStrong}</strong> {hero.lead}</p>
    <div class="actions">
      <a class="cta" href={`mailto:${links.email}`}>{hero.cta}<ArrowRight /></a>
      <Profiles links={links} label={ui.profiles} />
    </div>
  </div>
  {
    facts && (
      <aside aria-labelledby="hero-facts" class="facts">
        <h2 id="hero-facts" class="label facts-title">{facts.title}</h2>
        <dl>
          {facts.items.map((item) => (
            <div class="fact">
              <dt class="mono">{item.label}</dt>
              <dd>
                {item.tags && (
                  <ul class="list-reset chips">
                    {item.tags.map((tag) => (
                      <li class="chip">{tag}</li>
                    ))}
                  </ul>
                )}
                {(item.strong || item.text || item.link) && (
                  <p>
                    {item.strong && <strong>{item.strong}</strong>}
                    {item.strong && item.text && colon}
                    {item.text}
                    {item.link && (
                      <>
                        {' '}
                        <a href={item.link.href}>{item.link.label}</a>
                      </>
                    )}
                  </p>
                )}
              </dd>
            </div>
          ))}
        </dl>
      </aside>
    )
  }
</section>

<style>
  .hero {
    padding-top: 88px;
    padding-bottom: 120px;
  }

  .has-facts {
    display: grid;
    grid-template-columns: minmax(0, 1fr) clamp(340px, 32vw, 440px);
    gap: 72px;
    align-items: start;
  }

  .info {
    margin: 0;
    font-size: 14px;
    letter-spacing: 0.02em;
    color: var(--color-text-muted);
  }

  .heading {
    margin: 28px 0 0;
    font: inherit;
    letter-spacing: normal;
  }

  .name,
  .title {
    display: block;
  }

  .name {
    font-size: 128px;
    line-height: 0.9;
    font-weight: 800;
    letter-spacing: -0.045em;
  }

  .title {
    margin: 32px 0 0;
    font-size: 34px;
    line-height: 1.2;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--color-accent);
  }

  .lead {
    margin: 28px 0 0;
    max-width: 36em;
    font-size: 20px;
    line-height: 1.6;
    color: var(--color-text);
  }

  .lead strong {
    color: var(--color-ink);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 20px 36px;
    margin-top: 44px;
  }

  .cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    min-height: 56px;
    padding: 0 28px;
    border-radius: var(--radius-sm);
    background: var(--color-accent);
    color: var(--color-surface);
    font-size: 17px;
    font-weight: 600;
    text-decoration: none;
  }

  .cta:hover {
    background: var(--color-ink);
    color: var(--color-surface);
  }

  .facts {
    margin-top: 44px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
  }

  .facts-title {
    padding: 18px 28px;
    border-bottom: 1px solid var(--color-border);
  }

  .facts dl {
    margin: 0;
  }

  .fact {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 20px 28px;
  }

  .fact + .fact {
    border-top: 1px solid var(--color-border);
  }

  .fact dt {
    font-size: 12px;
    color: var(--color-text-muted);
  }

  .fact dd {
    margin: 0;
  }

  .fact p {
    margin: 0;
    font-size: 16px;
    line-height: 1.5;
    color: var(--color-ink);
  }

  .fact .chip {
    color: var(--color-ink);
  }

  @media (max-width: 960px) {
    .hero {
      padding-top: 36px;
      padding-bottom: 64px;
    }

    .has-facts {
      display: block;
    }

    .info {
      font-size: 12px;
      line-height: 1.6;
      letter-spacing: 0;
    }

    .heading {
      margin-top: 20px;
    }

    .name {
      font-size: 60px;
      line-height: 0.92;
    }

    .title {
      margin-top: 18px;
      font-size: 23px;
      letter-spacing: 0;
    }

    .lead {
      font-size: 17px;
    }

    .actions {
      flex-direction: column;
      align-items: stretch;
      gap: 16px;
      margin-top: 32px;
    }

    .cta {
      gap: 10px;
    }

    .actions :global(.profiles) {
      justify-content: center;
    }

    .facts {
      margin-top: 36px;
    }

    .facts-title {
      padding: 14px 20px;
    }

    .fact {
      padding: 16px 20px;
    }

    .fact p {
      font-size: 15px;
    }
  }
</style>
