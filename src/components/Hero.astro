---
import type { Content } from '../content/types';
import ArrowRight from './icons/ArrowRight.astro';
import Profiles from './Profiles.astro';

interface Props {
  content: Content;
}

const { hero, links, ui } = Astro.props.content;
const [firstName, ...lastNames] = hero.name.split(' ');
---

<section aria-labelledby="hero-title" class="wrap hero">
  <p class="mono info">{hero.info.join(' · ')}</p>
  <h1 id="hero-title" class="name">{firstName}<br />{lastNames.join(' ')}</h1>
  <p class="title">{hero.title}</p>
  <p class="lead"><strong>{hero.leadStrong}</strong> {hero.lead}</p>
  <div class="actions">
    <a class="cta" href={`mailto:${links.email}`}>{hero.cta}<ArrowRight /></a>
    <Profiles links={links} label={ui.profiles} />
  </div>
</section>

<style>
  .hero {
    padding-top: 88px;
    padding-bottom: 120px;
  }

  .info {
    margin: 0;
    font-size: 14px;
    letter-spacing: 0.02em;
    color: var(--color-text-muted);
  }

  .name {
    margin: 28px 0 0;
    font-size: 128px;
    line-height: 0.9;
    font-weight: 800;
    letter-spacing: -0.045em;
  }

  .title {
    margin: 32px 0 0;
    font-size: 34px;
    line-height: 1.2;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--color-accent);
  }

  .lead {
    margin: 28px 0 0;
    max-width: 36em;
    font-size: 20px;
    line-height: 1.6;
    color: var(--color-text);
  }

  .lead strong {
    color: var(--color-ink);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 20px 36px;
    margin-top: 44px;
  }

  .cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    min-height: 56px;
    padding: 0 28px;
    border-radius: var(--radius-sm);
    background: var(--color-accent);
    color: var(--color-surface);
    font-size: 17px;
    font-weight: 600;
    text-decoration: none;
  }

  .cta:hover {
    background: var(--color-ink);
    color: var(--color-surface);
  }

  @media (max-width: 960px) {
    .hero {
      padding-top: 36px;
      padding-bottom: 64px;
    }

    .info {
      font-size: 12px;
      line-height: 1.6;
      letter-spacing: 0;
    }

    .name {
      margin-top: 20px;
      font-size: 60px;
      line-height: 0.92;
    }

    .title {
      margin-top: 18px;
      font-size: 23px;
      letter-spacing: 0;
    }

    .lead {
      font-size: 17px;
    }

    .actions {
      flex-direction: column;
      align-items: stretch;
      gap: 16px;
      margin-top: 32px;
    }

    .cta {
      gap: 10px;
    }

    .actions :global(.profiles) {
      justify-content: center;
    }
  }
</style>
