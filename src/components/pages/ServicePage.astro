---
import Base from '../../layouts/Base.astro';
import Arrow from '../Arrow.astro';
import ProjectCard from '../ProjectCard.astro';
import Steps from '../Steps.astro';
import { href, pageTitle, type ServiceId, type SiteContent } from '../../site';
import { serviceGraph } from '../../site/jsonld';
import { rich } from '../../site/rich';

interface Props {
  site: SiteContent;
  id: ServiceId;
}

const { site, id } = Astro.props;
const { lang, ui } = site;
const service = site.services[id];
const { showcase } = service;
---

<Base site={site} page={id} title={pageTitle(site, service.meta)} description={service.meta.description} jsonLd={serviceGraph(site, id, Astro.site!)}>
  <section class="section--hero section--bordered service-hero">
    <div class="container">
      <div class="copy stack">
        <p class="eyebrow">{ui.servicePrefix} {service.number} · {service.eyebrow}</p>
        <h1 class="display">{service.h1}</h1>
        <p class="lead">{service.lead}</p>
        <div class="btn-row">
          <a class="btn btn--primary" href={href('contact', lang)}>{service.cta}<Arrow /></a>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container section-stack">
      <h2 class="title">{service.coverTitle}</h2>
      <div class="grid" style="--grid-gap: 40px 48px">
        {
          service.cover.map((item) => (
            <div class="feature">
              <h3>{item.title}</h3>
              <p class="small">{item.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <Steps eyebrow={ui.processEyebrow} title={service.process.title} steps={service.process.steps} />

  <section class="section">
    <div class="container section-stack">
      <div class="intro">
        <p class="eyebrow">{showcase.eyebrow}</p>
        <h2 class="title">{showcase.title}</h2>
      </div>
      {
        showcase.kind === 'projects' && (
          <div
            class:list={['grid', { 'grid--single': showcase.items.length === 1 }]}
            style={showcase.items.length === 3 ? undefined : '--grid-min: 320px; --grid-gap: 32px'}
          >
            {showcase.items.map((card) => <ProjectCard site={site} card={card} wide={showcase.items.length < 3} />)}
          </div>
        )
      }
      {
        showcase.kind === 'cards' && (
          <div class="grid">
            {showcase.items.map((item, i) => (
              <article class="card" style="--stack-gap: 14px; gap: 14px">
                {showcase.numbered && <span class="number">{String(i + 1).padStart(2, '0')}</span>}
                <h3 class="card-title card-title--sm">{item.title}</h3>
                <p class="small">{item.text}</p>
              </article>
            ))}
          </div>
        )
      }
      {
        showcase.kind === 'plans' && (
          <div class="grid">
            {showcase.items.map((plan) => (
              <article class:list={['card', { 'card--featured': plan.featured }]} style="gap: 16px">
                <h3 class="card-title card-title--sm">{plan.title}</h3>
                <p class="small">{plan.text}</p>
                <p class="price">
                  {plan.price} {plan.unit && <span class="unit">{plan.unit}</span>}
                </p>
                <ul class="list-reset ruled">
                  {plan.points.map((point) => <li>{point}</li>)}
                </ul>
              </article>
            ))}
          </div>
        )
      }
    </div>
  </section>

  <section class="section section--mist">
    <div class="container stack" style="--stack-gap: 40px">
      <h2 class="title">{ui.faqTitle}</h2>
      <div class="grid faq">
        {
          service.faq.map(({ question, answer }) => (
            <div>
              <h3>{question}</h3>
              <p class="small" set:html={rich(answer, lang)} />
            </div>
          ))
        }
      </div>
    </div>
  </section>
</Base>
