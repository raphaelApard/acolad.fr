---
import { pageGraph } from '../../site/jsonld';
import Base from '../../layouts/Base.astro';
import Arrow from '../Arrow.astro';
import { business } from '../../content/business';
import { pageTitle, serviceIds, type SiteContent } from '../../site';
import { rich } from '../../site/rich';

interface Props {
  site: SiteContent;
}

const { site } = Astro.props;
const { lang, contact } = site;
const { details, form } = contact;
const needs = [...serviceIds.map((id) => site.services[id].contactOption), form.otherNeed];
---

<Base site={site} page="contact" jsonLd={pageGraph(site, 'contact', Astro.site!)} title={pageTitle(site, contact.meta)} description={contact.meta.description} hideCta>
  <section class="contact-page">
    <div class="container">
      <div class="copy stack">
        <p class="eyebrow">{contact.eyebrow}</p>
        <h1 class="display">{contact.h1}</h1>
        <p class="lead">{contact.lead}</p>
        <dl class="facts facts--plain">
          <div>
            <dt class="label">{details.email}</dt>
            <dd><a href={`mailto:${business.email}`}>{business.email}</a></dd>
          </div>
          <div>
            <dt class="label">{details.phone}</dt>
            <dd><a href={`tel:${business.telephone}`}>{business.telephoneDisplay}</a></dd>
          </div>
          <div>
            <dt class="label">{details.address}</dt>
            <dd>{details.addressLines.map((line) => <span>{line}</span>)}</dd>
          </div>
        </dl>
        <div class="next-steps stack on-dark">
          <p class="label">{contact.next.title}</p>
          <ol class="list-reset">
            {
              contact.next.steps.map((step, i) => (
                <li>
                  <span class="number">{String(i + 1).padStart(2, '0')}</span>
                  <span>{step}</span>
                </li>
              ))
            }
          </ol>
        </div>
      </div>

      <!-- Posted to public/contact.php, which e-mails it. The script below sends it with fetch and
           shows the outcome in place; without JavaScript the browser posts it and comes back to
           #contact-sent or #contact-failed, which the stylesheet reveals with :target. -->
      <form class="contact-form stack" method="post" action="/contact.php" data-contact-form>
        <input type="hidden" name="lang" value={lang} />
        <div class="grid field-row">
          <div class="field">
            <label for="contact-name">{form.name}</label>
            <input id="contact-name" name="name" type="text" autocomplete="name" maxlength="200" required />
          </div>
          <div class="field">
            <label for="contact-company">{form.company}</label>
            <input id="contact-company" name="company" type="text" autocomplete="organization" maxlength="200" />
          </div>
        </div>
        <div class="field">
          <label for="contact-email">{form.email}</label>
          <input id="contact-email" name="email" type="email" autocomplete="email" maxlength="254" required />
        </div>
        <div class="field">
          <label for="contact-need">{form.need}</label>
          <select id="contact-need" name="need">
            {needs.map((need) => <option>{need}</option>)}
          </select>
        </div>
        <div class="field">
          <label for="contact-message">{form.message}</label>
          <textarea id="contact-message" name="message" rows="7" maxlength="10000" aria-describedby="contact-message-hint" required></textarea>
          <span class="hint" id="contact-message-hint">{form.messageHint}</span>
        </div>
        <!-- Trap for robots: hidden from people and assistive technologies, left empty by them. -->
        <div class="trap" aria-hidden="true">
          <label for="contact-website">Website</label>
          <input id="contact-website" name="website" type="text" tabindex="-1" autocomplete="off" />
        </div>
        <button type="submit" class="btn btn--primary">{form.submit}<Arrow /></button>
        <p class="notice" id="contact-sent" tabindex="-1" data-contact-notice="sent">{form.sent}</p>
        <p class="notice notice--error" id="contact-failed" tabindex="-1" data-contact-notice="failed" set:html={rich(form.failed, lang)} />
        <p class="hint" set:html={rich(form.privacy, lang)} />
      </form>
    </div>
  </section>
</Base>

<script>
  // Sends the form with fetch so the visitor stays on the page, then shows the outcome and
  // moves the focus to it, so screen readers read it out.
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const notices = form.querySelectorAll<HTMLElement>('[data-contact-notice]');
    const show = (outcome: 'sent' | 'failed') => {
      notices.forEach((notice) => notice.classList.toggle('is-shown', notice.dataset.contactNotice === outcome));
      form.querySelector<HTMLElement>(`[data-contact-notice="${outcome}"]`)!.focus();
    };

    // From now on the script shows the outcome, whatever anchor the page was loaded with.
    form.classList.add('is-scripted');
    button.disabled = true;
    notices.forEach((notice) => notice.classList.remove('is-shown'));
    try {
      const response = await fetch(form.action, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } });
      const result = (await response.json()) as { ok?: boolean };
      if (!response.ok || !result.ok) throw new Error(`contact form: HTTP ${response.status}`);
      form.reset();
      show('sent');
    } catch {
      // The answers stay in the form, so the visitor can try again or copy them.
      show('failed');
    } finally {
      button.disabled = false;
    }
  });
</script>
