---
import type { Content } from '../content/types';
import SectionTitle from './SectionTitle.astro';
import ArrowUpRight from './icons/ArrowUpRight.astro';

interface Props {
  content: Content;
}

const { credentials, ui } = Astro.props.content;
const { certifications, education, languages } = credentials;
---

<section id="certifications" aria-labelledby="t-credentials" class="credentials">
  <div class="wrap section">
    <div class="head">
      <SectionTitle id="t-credentials" number={credentials.number} title={credentials.title} />
    </div>
    <div class="columns">
      <div>
        <h3 class="label">{certifications.title}</h3>
        <ul class="list-reset entries">
          {
            certifications.items.map((c) => (
              <li>
                <p class="name">{c.name}</p>
                <p class="detail cert-detail">
                  <span class="mono">{c.year}</span>
                  {c.verifyUrl && (
                    <a
                      class="ext-link verify"
                      href={c.verifyUrl}
                      aria-label={`${ui.verifyAriaPrefix} ${c.name}`}
                      rel="noopener"
                      target="_blank"
                    >
                      {credentials.verifyLabel}
                      <span class="arrow">
                        <ArrowUpRight size={14} />
                      </span>
                    </a>
                  )}
                </p>
              </li>
            ))
          }
        </ul>
      </div>
      <div>
        <h3 class="label">{education.title}</h3>
        <ul class="list-reset entries">
          {
            education.items.map((e) => (
              <li>
                <p class="name">{e.name}</p>
                <p class="detail">
                  {e.school} · <span class="mono">{e.period}</span>
                </p>
              </li>
            ))
          }
        </ul>
      </div>
      <div>
        <h3 class="label">{languages.title}</h3>
        <dl class="languages">
          {
            languages.items.map((l) => (
              <div>
                <dt>{l.name}</dt>
                <dd>{l.level}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </div>
</section>

<style>
  .credentials {
    background: var(--color-surface);
    border-top: 1px solid var(--color-border);
    /* Land 1px higher than other anchors: this top border then sits under the sticky header's
       own border, leaving a single line instead of a double one. */
    scroll-margin-top: -1px;
  }

  .section {
    padding-top: var(--section-pad-desktop);
    padding-bottom: var(--section-pad-desktop);
  }

  .head {
    margin-bottom: 56px;
  }

  .columns {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 56px 48px;
  }

  .label {
    margin-bottom: 8px;
  }

  .entries li {
    padding: 20px 0;
    border-top: 1px solid var(--color-border);
  }

  .name {
    margin: 0;
    font-size: 18px;
    line-height: 1.35;
    font-weight: 600;
  }

  .detail {
    margin: 6px 0 0;
    font-size: 15px;
    line-height: 1.5;
    color: var(--color-text-muted);
  }

  .cert-detail {
    display: flex;
    gap: 16px;
    align-items: center;
  }

  .verify {
    gap: 4px;
    font-weight: 500;
    text-underline-offset: 4px;
  }

  .arrow {
    display: inline-flex;
  }

  .languages {
    margin: 0;
  }

  .languages div {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 20px 0;
    border-top: 1px solid var(--color-border);
  }

  .languages div:last-child {
    border-bottom: 1px solid var(--color-border);
  }

  .languages dt {
    font-size: 18px;
    font-weight: 600;
  }

  .languages dd {
    margin: 0;
    font-size: 15px;
    color: var(--color-text-muted);
    text-align: right;
  }

  @media (max-width: 960px) {
    .arrow {
      display: none;
    }

    .section {
      padding-top: var(--section-pad-mobile);
      padding-bottom: var(--section-pad-mobile);
    }

    .head {
      margin-bottom: 32px;
    }

    .columns {
      grid-template-columns: 1fr;
      gap: 36px;
    }

    .label {
      margin-bottom: 4px;
    }

    .entries li {
      padding: 16px 0;
    }

    .name {
      font-size: 17px;
    }

    .detail {
      font-size: 14px;
    }

    .languages div {
      gap: 12px;
      padding: 14px 0;
    }

    .languages dt {
      font-size: 17px;
    }

    .languages dd {
      font-size: 14px;
    }
  }
</style>
