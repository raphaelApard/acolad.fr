---
import type { Content } from '../content/types';
import ArrowRight from './icons/ArrowRight.astro';
import Check from './icons/Check.astro';
import Copy from './icons/Copy.astro';
import Profiles from './Profiles.astro';

interface Props {
  content: Content;
  /** True on the legal notice page itself. */
  onLegalPage?: boolean;
}

const { contact, links, ui, legal } = Astro.props.content;
const { onLegalPage = false } = Astro.props;
---

<footer id="contact" class="dark">
  <div class="wrap section">
    <h2 class="heading">{contact.title}</h2>
    <div class="email-row">
      <a class="email" href={`mailto:${links.email}`}>
        {links.email}<span class="arrow"><ArrowRight size={32} /></span>
      </a>
      {/* Shown by the script only where the Clipboard API is available. */}
      <button type="button" class="copy" data-copy-email={links.email} hidden>
        <span class="copy-icon"><Copy /></span>
        <span class="done-icon"><Check /></span>
        <span class="copy-label">{ui.copyEmail}</span>
        <span class="done-label">{ui.emailCopied}</span>
      </button>
      <p class="sr-only" role="status" data-copy-status data-message={ui.emailCopied}></p>
    </div>
    <Profiles links={links} label={ui.profiles} class="footer-profiles" />
    <div class="bottom">
      <p class="mono">{contact.footer}</p>
      <div class="bottom-links">
        <a href={legal.path} class="mono" aria-current={onLegalPage ? 'page' : undefined}>{legal.linkLabel}</a>
        {/* No element has id="top": the browser then scrolls to the top of the document. (Pointing
            at the sticky header did nothing, as it is always in view.) */}
        <a href="#top" class="mono desktop-only">{contact.backToTop}</a>
      </div>
    </div>
  </div>
</footer>

<script>
  // Copy the e-mail address; the button flips to "copied" for two seconds.
  const button = document.querySelector<HTMLButtonElement>('[data-copy-email]');
  const status = document.querySelector<HTMLElement>('[data-copy-status]');

  if (button && status && navigator.clipboard) {
    let reset: number | undefined;
    button.hidden = false;
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.copyEmail ?? '');
      } catch {
        return;
      }
      button.toggleAttribute('data-copied', true);
      status.textContent = status.dataset.message ?? '';
      window.clearTimeout(reset);
      reset = window.setTimeout(() => {
        button.removeAttribute('data-copied');
        status.textContent = '';
      }, 2000);
    });
  }
</script>

<style>
  .section {
    padding-top: 120px;
    padding-bottom: 48px;
  }

  .heading {
    margin: 0;
    max-width: 14em;
    font-size: 72px;
    line-height: 1;
    font-weight: 800;
    letter-spacing: -0.04em;
  }

  /* The copy button sits on its own line, under the address. */
  .email-row {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
    margin-top: 48px;
  }

  .copy {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 0 16px;
    border: 1px solid var(--color-dark-chip);
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--color-dark-text);
    font: 500 14px var(--font-mono);
    cursor: pointer;
    transition: border-color 0.2s ease, color 0.2s ease;
  }

  .copy:hover {
    border-color: var(--color-dark-accent);
    color: var(--color-dark-accent);
  }

  .copy[hidden] {
    display: none;
  }

  .copy-icon,
  .done-icon {
    display: inline-flex;
  }

  .copy:not([data-copied]) .done-icon,
  .copy:not([data-copied]) .done-label,
  .copy[data-copied] .copy-icon,
  .copy[data-copied] .copy-label {
    display: none;
  }

  .copy[data-copied] {
    border-color: var(--color-dark-accent);
    color: var(--color-dark-accent);
  }

  @media (prefers-reduced-motion: reduce) {
    .copy {
      transition: none;
    }
  }

  .dark .email {
    display: inline-flex;
    align-items: center;
    gap: 16px;
    min-height: 44px;
    font-size: 40px;
    font-weight: 500;
    letter-spacing: -0.02em;
    color: var(--color-dark-accent);
    text-underline-offset: 10px;
    text-decoration-thickness: 2px;
    overflow-wrap: anywhere;
  }

  .arrow {
    display: inline-flex;
  }

  .section :global(.footer-profiles) {
    gap: 8px 32px;
    margin-top: 40px;
    font-size: 17px;
  }

  .bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 16px;
    margin-top: 96px;
    padding-top: 24px;
    border-top: 1px solid var(--color-dark-border);
    font-size: 13px;
  }

  .bottom p {
    margin: 0;
    color: var(--color-dark-muted);
  }

  .bottom-links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
  }

  .dark .bottom a {
    color: var(--color-dark-muted);
    text-underline-offset: 4px;
  }

  .dark .bottom a:hover {
    color: var(--color-dark-accent);
  }

  @media (max-width: 960px) {
    .arrow {
      display: none;
    }

    .section {
      padding-top: 72px;
      padding-bottom: 32px;
    }

    .heading {
      font-size: 40px;
      line-height: 1.02;
    }

    .email-row {
      margin-top: 28px;
    }

    .dark .email {
      font-size: 21px;
      letter-spacing: 0;
      text-underline-offset: 6px;
    }

    .section :global(.footer-profiles) {
      gap: 28px;
      margin-top: 20px;
      font-size: 16px;
    }

    .bottom {
      margin-top: 56px;
      padding-top: 20px;
      font-size: 12px;
    }
  }
</style>
