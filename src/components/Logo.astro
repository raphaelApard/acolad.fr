---
// The company mark, "< / >" on a dark square, drawn after the logo file.
interface Props {
  /** On dark grounds the square gets a hairline so it stays visible. */
  outlined?: boolean;
}

const { outlined = false } = Astro.props;
---

<svg aria-hidden="true" width="40" height="40" viewBox="0 0 40 40" fill="none">
  <rect
    x={outlined ? 0.5 : 0}
    y={outlined ? 0.5 : 0}
    width={outlined ? 39 : 40}
    height={outlined ? 39 : 40}
    rx="9"
    fill="#2d2d2f"
    stroke={outlined ? '#4a5568' : undefined}
  ></rect>
  <path d="M12.6 17.6 5.4 20.9l7.2 3.3M22.2 13.8l-4.4 12.4M27.4 17.6l7.2 3.3-7.2 3.3" stroke="#fff" stroke-width="1.4"></path>
</svg>
