---
// A mission's page of its own, one per locale (paths in content `caseStudy.path`), linked from
// its row in the missions section of the home page.
import { Image } from 'astro:assets';
import { getAbsoluteLocaleUrl, getRelativeLocaleUrl } from 'astro:i18n';
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import ArrowRight from './icons/ArrowRight.astro';
import { findCaseStudy, getContent, langs } from '../content';
import { findSection, sectionAnchors, type Lang } from '../content/types';
import { asset } from '../lib/images';

interface Props {
  lang: Lang;
  slug: string;
}

const { lang, slug } = Astro.props;
const content = getContent(lang);
const { hero, links, ui } = content;
const missions = findSection(content, 'missions')!;
const mission = findCaseStudy(lang, slug);
const study = mission.caseStudy;
const alternates = Object.fromEntries(langs.map((l) => [l, findCaseStudy(l, slug).caseStudy.path])) as Record<Lang, string>;

const home = getRelativeLocaleUrl(lang);
const missionsUrl = `${home}#${sectionAnchors.missions}`;
const site = Astro.site!;
const url = new URL(study.path, site).href;
const meta = [mission.period, mission.place].filter(Boolean).join(' · ');

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Article',
      '@id': `${url}#article`,
      headline: study.title,
      description: study.description,
      inLanguage: lang,
      url,
      mainEntityOfPage: url,
      author: { '@id': new URL('#person', site).href },
      publisher: { '@id': new URL('#business', site).href },
      about: { '@type': 'Organization', name: mission.client },
      keywords: mission.stack?.join(', '),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { name: ui.home, item: getAbsoluteLocaleUrl(lang) },
        { name: missions.title, item: new URL(missionsUrl, site).href },
        { name: mission.client, item: url },
      ].map((entry, i) => ({ '@type': 'ListItem', position: i + 1, ...entry })),
    },
  ],
};
---

<Base content={content} title={`${study.title} — ${hero.name}`} description={study.description} alternates={alternates}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} slot="head" />
  <a class="skip-link" href="#content">{ui.skipLink}</a>
  <Header content={content} alternates={alternates} />
  <main id="content" class="wrap case-study">
    <nav aria-label={ui.breadcrumb} class="mono breadcrumb">
      <ol class="list-reset">
        <li><a href={home}>{ui.home}</a></li>
        <li><a href={missionsUrl}>{missions.title}</a></li>
        <li aria-current="page">{mission.client}</li>
      </ol>
    </nav>

    <header class="intro">
      {meta && <p class="mono meta">{meta}</p>}
      <h1>{study.title}</h1>
      <p class="role">{mission.role}</p>
      <p class="lead">{study.intro}</p>
    </header>

    {
      mission.image && (
        <figure class="figure">
          <Image
            src={asset(mission.image.src)}
            alt={mission.image.alt}
            widths={[400, 800, 1200]}
            sizes="(max-width: 960px) calc(100vw - 40px), 880px"
            class="picture"
          />
        </figure>
      )
    }

    {
      study.sections.map((section) => (
        <section>
          <h2>{section.heading}</h2>
          {section.paragraphs.map((p) => (
            <p>{p}</p>
          ))}
        </section>
      ))
    }

    {
      mission.achievements && (
        <section>
          <h2>{missions.achievementsLabel}</h2>
          <ul class="list-reset bullets">
            {mission.achievements.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </section>
      )
    }

    {
      mission.stack && (
        <section>
          <h2>{missions.stackLabel}</h2>
          <ul class="list-reset chips">
            {mission.stack.map((item) => (
              <li class="chip">{item}</li>
            ))}
          </ul>
        </section>
      )
    }

    <p class="actions">
      <a class="cta" href={`mailto:${links.email}`}>{hero.cta}<ArrowRight /></a>
    </p>
  </main>
  <Footer content={content} />
</Base>

<style>
  .case-study {
    padding-top: 56px;
    padding-bottom: var(--section-pad-desktop);
  }

  .breadcrumb {
    font-size: 13px;
    color: var(--color-text-muted);
  }

  .breadcrumb ol {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 10px;
  }

  .breadcrumb li + li::before {
    content: '/';
    margin-right: 10px;
    color: var(--color-border-strong);
  }

  .breadcrumb a {
    color: var(--color-text-muted);
    text-underline-offset: 3px;
  }

  .breadcrumb a:hover {
    color: var(--color-accent);
  }

  .intro {
    max-width: 44em;
    margin-top: 40px;
  }

  p {
    margin: 0;
  }

  .meta {
    font-size: 14px;
    font-weight: 500;
    color: var(--color-accent);
  }

  h1 {
    margin: 16px 0 0;
    font-size: 44px;
    line-height: 1.08;
    font-weight: 700;
    letter-spacing: -0.025em;
  }

  .role {
    margin-top: 16px;
    font-size: 19px;
    font-weight: 600;
  }

  .lead {
    margin-top: 20px;
    font-size: 20px;
    line-height: 1.6;
    color: var(--color-text);
  }

  .figure {
    max-width: 880px;
    margin: 48px 0 0;
  }

  .picture {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
  }

  section {
    max-width: 44em;
    margin-top: 48px;
    padding-top: 24px;
    border-top: 1px solid var(--color-border);
  }

  h2 {
    margin: 0 0 16px;
    font-size: 22px;
    line-height: 1.25;
    font-weight: 700;
  }

  section p {
    font-size: 17px;
    line-height: 1.6;
    color: var(--color-text);
  }

  section p + p {
    margin-top: 12px;
  }

  .actions {
    margin-top: 56px;
  }

  .cta {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    min-height: 56px;
    padding: 0 28px;
    border-radius: var(--radius-sm);
    background: var(--color-accent);
    color: var(--color-surface);
    font-size: 17px;
    font-weight: 600;
    text-decoration: none;
  }

  .cta:hover {
    background: var(--color-ink);
    color: var(--color-surface);
  }

  @media (max-width: 960px) {
    .case-study {
      padding-top: 32px;
      padding-bottom: var(--section-pad-mobile);
    }

    .intro {
      margin-top: 28px;
    }

    h1 {
      font-size: 32px;
    }

    .role {
      font-size: 17px;
    }

    .lead {
      font-size: 17px;
    }

    .figure {
      margin-top: 32px;
    }

    section {
      margin-top: 36px;
    }

    h2 {
      font-size: 19px;
    }

    section p {
      font-size: 15px;
    }

    .cta {
      display: flex;
      justify-content: center;
    }
  }
</style>
