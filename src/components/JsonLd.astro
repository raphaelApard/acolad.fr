---
// Structured data of the home pages: the site, this page as the person's profile, the person
// (credentials, education, languages from the credentials section) and the company. The @ids are
// shared by both locales so search engines see one site, one person and one company.
import { getAbsoluteLocaleUrl } from 'astro:i18n';
import { langs } from '../content';
import { business } from '../content/business';
import { findSection, type Content } from '../content/types';

interface Props {
  content: Content;
}

const { content } = Astro.props;
const { meta, hero, links } = content;
const skills = findSection(content, 'skills');
const credentials = findSection(content, 'credentials');
const site = Astro.site!;
const personId = new URL('#person', site).href;
const businessId = new URL('#business', site).href;
const websiteId = new URL('#website', site).href;
const url = getAbsoluteLocaleUrl(meta.lang);
const schools = [...new Set(credentials?.education.items.map((item) => item.school) ?? [])];
const sameAs = [links.linkedin, links.malt, links.github].filter((link): link is string => Boolean(link));

const graph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': websiteId,
      url: new URL('/', site).href,
      name: hero.name,
      inLanguage: langs,
      publisher: { '@id': personId },
    },
    {
      '@type': 'ProfilePage',
      '@id': `${url}#webpage`,
      url,
      name: meta.title,
      inLanguage: meta.lang,
      isPartOf: { '@id': websiteId },
      mainEntity: { '@id': personId },
    },
    {
      '@type': 'Person',
      '@id': personId,
      name: hero.name,
      jobTitle: hero.title,
      description: meta.description,
      url,
      email: `mailto:${links.email}`,
      address: { '@type': 'PostalAddress', ...business.home },
      workLocation: {
        '@type': 'Place',
        address: { '@type': 'PostalAddress', addressLocality: business.workLocality, addressCountry: 'FR' },
      },
      knowsAbout: skills?.groups.flatMap((group) => group.items) ?? [],
      knowsLanguage: credentials?.languages.items.map(({ name }) => ({ '@type': 'Language', name })) ?? [],
      hasCredential:
        credentials?.certifications.items.map(({ name, year, verifyUrl }) => ({
          '@type': 'EducationalOccupationalCredential',
          name,
          credentialCategory: 'certification',
          dateCreated: year,
          ...(verifyUrl && { url: verifyUrl }),
        })) ?? [],
      alumniOf: schools.map((name) => ({ '@type': 'EducationalOrganization', name })),
      sameAs,
      worksFor: { '@id': businessId },
    },
    {
      '@type': 'ProfessionalService',
      '@id': businessId,
      name: business.name,
      legalName: business.legalName,
      description: meta.description,
      url,
      email: links.email,
      telephone: business.telephone,
      foundingDate: business.foundingDate,
      vatID: business.vatID,
      address: { '@type': 'PostalAddress', ...business.address },
      areaServed: [
        { '@type': 'City', name: business.workLocality },
        { '@type': 'Country', name: 'France' },
      ],
      founder: { '@id': personId },
      employee: { '@id': personId },
    },
  ],
};
// "<" escaped so the JSON can never close the script element.
const json = JSON.stringify(graph).replace(/</g, '\\u003c');
---

<script type="application/ld+json" set:html={json} />
