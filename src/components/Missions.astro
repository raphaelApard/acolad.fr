---
import type { Content } from '../content/types';
import SectionTitle from './SectionTitle.astro';
import TimelineRow from './TimelineRow.astro';
import OtherProjects from './OtherProjects.astro';

interface Props {
  content: Content;
}

const { missions, otherProjects } = Astro.props.content;
---

<section id="missions" aria-labelledby="t-missions">
  <div class="wrap section">
    <div class="intro">
      <SectionTitle id="t-missions" number={missions.number} title={missions.title} />
      <p class="company"><strong>{missions.company}</strong> — {missions.since}</p>
    </div>
    {
      missions.items.map((m, i) => (
        <TimelineRow
          id={`mission-${i}`}
          period={m.period}
          title={m.client}
          place={m.place}
          role={m.role}
          text={m.hook}
          achievements={m.achievements}
          achievementsLabel={missions.achievementsLabel}
          stack={m.stack}
          stackLabel={missions.stackLabel}
          image={m.image}
        />
      ))
    }
  </div>
  <OtherProjects otherProjects={otherProjects} />
</section>

<style>
  .section {
    padding-top: var(--section-pad-desktop);
    padding-bottom: 48px;
  }

  .intro {
    display: grid;
    grid-template-columns: 340px minmax(0, 1fr);
    gap: 64px;
    align-items: end;
    margin-bottom: 56px;
  }

  .company {
    margin: 0;
    font-size: 19px;
    line-height: 1.5;
    color: var(--color-text-muted);
  }

  .company strong {
    color: var(--color-ink);
    font-weight: 600;
  }

  @media (max-width: 960px) {
    .section {
      padding-top: var(--section-pad-mobile);
      padding-bottom: 24px;
    }

    .intro {
      grid-template-columns: 1fr;
      gap: 14px;
      margin-bottom: 32px;
    }

    .company {
      font-size: 16px;
    }
  }
</style>
