---
import type { GetStaticPaths } from 'astro';
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Domains from '../components/Domains.astro';
import AiBand from '../components/AiBand.astro';
import ClientLogos from '../components/ClientLogos.astro';
import Skills from '../components/Skills.astro';
import Missions from '../components/Missions.astro';
import Experience from '../components/Experience.astro';
import Credentials from '../components/Credentials.astro';
import Footer from '../components/Footer.astro';
import Lightbox from '../components/Lightbox.astro';
import JsonLd from '../components/JsonLd.astro';
import { defaultLang, getContent, langs } from '../content';
import type { Lang } from '../content/types';

// French is served at the root, every other locale under its own prefix (/en/).
export const getStaticPaths = (() =>
  langs.map((lang) => ({ params: { lang: lang === defaultLang ? undefined : lang } }))) satisfies GetStaticPaths;

const content = getContent((Astro.params.lang ?? defaultLang) as Lang);
---

<Base content={content}>
  <JsonLd content={content} slot="head" />
  <a class="skip-link" href="#content">{content.ui.skipLink}</a>
  <Header content={content} />
  <main id="content">
    <Hero content={content} />
    {
      content.sections.map((section) => {
        switch (section.type) {
          case 'domains':
            return <Domains section={section} />;
          case 'ai':
            return <AiBand section={section} ui={content.ui} />;
          case 'clients':
            return <ClientLogos section={section} />;
          case 'skills':
            return <Skills section={section} />;
          case 'missions':
            return <Missions section={section} ui={content.ui} />;
          case 'experience':
            return <Experience section={section} />;
          case 'credentials':
            return <Credentials section={section} ui={content.ui} />;
        }
      })
    }
  </main>
  <Footer content={content} />
  <Lightbox content={content} />
</Base>

<script>
  import { initDisclosures } from '../scripts/disclosure';
  initDisclosures();
</script>
