---
// Static hosting has no server redirect: send `/` to the default locale immediately.
import { getAbsoluteLocaleUrl, getRelativeLocaleUrl } from 'astro:i18n';

const target = getRelativeLocaleUrl('fr');
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <title>Raphaël Apard</title>
    <meta http-equiv="refresh" content={`0;url=${target}`} />
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={getAbsoluteLocaleUrl('fr')} />
  </head>
  <body>
    <a href={target}>{target}</a>
  </body>
</html>
