# Copy to .env and adjust. Never commit the real file.

# Long random string (openssl rand -hex 32).
PAYLOAD_SECRET=change-me
# SQLite file, relative to apps/cms.
DATABASE_URI=file:./data/cms.db
# Public URL of this CMS (used in admin links and emails).
CMS_URL=http://localhost:3000
# Origin of the public site allowed to call the contact endpoint (CORS).
SITE_URL=http://localhost:4321
