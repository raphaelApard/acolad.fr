# Copy to .env and adjust. Never commit the real file.

# Long random string (openssl rand -hex 32).
PAYLOAD_SECRET=change-me
# SQLite file, relative to apps/cms.
DATABASE_URI=file:./data/cms.db
# Public URL of this CMS (used in admin links and emails).
CMS_URL=http://localhost:3000
# Origin of the public site allowed to call the contact endpoint (CORS).
SITE_URL=http://localhost:4321

# Contact form notifications. Without SMTP_HOST, emails are only logged to the console.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Sender address (must be allowed by the SMTP server).
CONTACT_FROM=no-reply@acolad.fr
# Recipient; defaults to the email address set in the "Site settings" global.
CONTACT_TO=
