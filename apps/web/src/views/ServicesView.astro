---
import Chips from '../components/Chips.astro'
import ContactStrip from '../components/ContactStrip.astro'
import PageHead from '../components/PageHead.astro'
import BaseLayout from '../layouts/BaseLayout.astro'
import { getDocs, getGlobal } from '../lib/cms'
import { pageGraph } from '../lib/jsonld'
import type { Locale } from '../lib/routes'

interface Props {
  locale: Locale
}

const { locale } = Astro.props

const [site, labels, page, services] = await Promise.all([
  getGlobal('site', locale),
  getGlobal('labels', locale),
  getGlobal('services-page', locale),
  getDocs('services', locale),
])

const number = (index: number) => String(index + 1).padStart(2, '0')
const jsonLd = pageGraph({ site: Astro.site!, locale, key: 'services', seo: page.seo }, labels)
---

<BaseLayout locale={locale} pageKey="services" seo={page.seo} site={site} labels={labels} jsonLd={jsonLd}>
  <PageHead locale={locale} labels={labels} title={page.head.title} subtitle={page.head.subtitle} />

  <div class="offers">
    {
      services.map((service, index) => (
        <section id={service.anchor} class="offer" aria-labelledby={`${service.anchor}-title`}>
          <p class="offer__number">{number(index)}</p>
          <div class="offer__body">
            <div class="offer__intro">
              <h2 id={`${service.anchor}-title`} class="offer__title">
                {service.title}
              </h2>
              <p class="offer__desc">{service.longDesc}</p>
            </div>
            <div class="offer__details">
              <div>
                <h3 class="label">{labels.common.deliverables}</h3>
                <ul class="deliverables">
                  {(service.deliverables ?? []).map((item) => <li>{item.text}</li>)}
                </ul>
              </div>
              <div>
                <h3 class="label">{labels.common.stack}</h3>
                <Chips items={service.stack ?? []} />
              </div>
            </div>
          </div>
        </section>
      ))
    }
  </div>

  <section class="section section--tight" aria-labelledby="method-title">
    <h2 id="method-title" class="section__label">{page.methodTitle}</h2>
    <ol class="section__body points">
      {
        (page.process ?? []).map((step, index) => (
          <li class="point">
            <p class="point__number">{number(index)}</p>
            <h3 class="point__title">{step.title}</h3>
            <p class="point__desc">{step.description}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <ContactStrip locale={locale} site={site} labels={labels} closing={page.closing} />
</BaseLayout>
