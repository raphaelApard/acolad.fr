---
import { BLOCKS } from '../components/blocks'
import Lightbox from '../components/Lightbox.astro'
import SiteFooter from '../components/SiteFooter.astro'
import BaseLayout from '../layouts/BaseLayout.astro'
import { getDocs, getGlobal, getPages } from '../lib/cms'
import type { PageContext } from '../lib/context'
import { homeGraph, pageGraph } from '../lib/jsonld'
import { loadSitePages, type Block } from '../lib/pages'
import type { Locale } from '../lib/routes'

interface Props {
  pageId: number
  locale: Locale
}

const { pageId, locale } = Astro.props

const [site, labels, pages, docs] = await Promise.all([
  getGlobal('site', locale),
  getGlobal('labels', locale),
  loadSitePages(),
  getPages(locale),
])

const page = docs.find((doc) => doc.id === pageId)!
const current = pages.find((candidate) => candidate.id === pageId)!
const ctx: PageContext = { locale, site, labels, pages, current, sections: page.sections }

const common = { site: Astro.site!, locale, page: current, seo: page.seo }
const servicesSummary = page.sections.find(
  (section): section is Block<'services'> => section.blockType === 'services' && section.variant === 'summary',
)
const jsonLd = current.isHome
  ? homeGraph(common, {
      settings: site,
      services: await getDocs('services', locale),
      catalogName: servicesSummary?.label ?? current.navLabel[locale],
    })
  : pageGraph(common, pages)

// Project screenshots open in the lightbox. A page without closing block ends with a plain footer instead.
const hasLightbox = page.sections.some((section) => section.blockType === 'projects')
const hasClosing = page.sections.some((section) => section.blockType === 'closingCta')
---

<BaseLayout ctx={ctx} seo={page.seo} jsonLd={jsonLd}>
  {
    page.sections.map((block, index) => {
      const Section = BLOCKS[block.blockType]
      return <Section block={block} ctx={ctx} index={index} />
    })
  }
  <Fragment slot="after-main">
    {hasLightbox && <Lightbox labels={labels} />}
    {!hasClosing && <SiteFooter site={site} />}
  </Fragment>
</BaseLayout>
