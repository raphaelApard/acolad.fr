---
import ContactStrip from '../components/ContactStrip.astro'
import Lightbox from '../components/Lightbox.astro'
import PageHead from '../components/PageHead.astro'
import ProjectMedia from '../components/ProjectMedia.astro'
import BaseLayout from '../layouts/BaseLayout.astro'
import { getDocs, getGlobal, resolveMedia } from '../lib/cms'
import { pageGraph } from '../lib/jsonld'
import type { Locale } from '../lib/routes'

interface Props {
  locale: Locale
}

const { locale } = Astro.props

const [site, labels, page, projects] = await Promise.all([
  getGlobal('site', locale),
  getGlobal('labels', locale),
  getGlobal('work-page', locale),
  getDocs('projects', locale, 1),
])

const number = (index: number) => String(index + 1).padStart(2, '0')
const jsonLd = pageGraph({ site: Astro.site!, locale, key: 'work', seo: page.seo }, labels)
const filters = [
  { value: 'all', label: labels.work.filterAll },
  { value: 'web', label: labels.work.filterWeb },
  { value: 'ia', label: labels.work.filterAi },
]
---

<BaseLayout locale={locale} pageKey="work" seo={page.seo} site={site} labels={labels} jsonLd={jsonLd}>
  <PageHead locale={locale} labels={labels} title={page.head.title} subtitle={page.head.subtitle} />

  <!-- Shown by the script below: without JavaScript every project stays visible and there is nothing to filter. -->
  <div class="filters" role="group" aria-labelledby="filters-label" data-filters hidden>
    <span id="filters-label" class="filters__label">{labels.work.filter}</span>
    {
      filters.map((filter) => (
        <button
          type="button"
          class="filter"
          data-filter={filter.value}
          aria-pressed={filter.value === 'all' ? 'true' : 'false'}
        >
          {filter.label}
        </button>
      ))
    }
  </div>

  <ul class="cases">
    {
      projects.map((project, index) => (
        <li data-category={project.category}>
          <article class="case">
            <p class="case__meta">
              <span data-index>{number(index)}</span>
              <br />
              {project.year && (
                <>
                  {project.year}
                  <br />
                </>
              )}
              {project.tag}
            </p>
            <div class="case__body">
              <ProjectMedia media={resolveMedia(project.image)} labels={labels} class="case__media" />
              <div class="case__text">
                <h2 class="case__title">{project.title}</h2>
                <p class="case__desc">{project.longDesc}</p>
                {(project.client || project.result || project.stack) && (
                  <dl class="case__facts">
                    {project.client && (
                      <>
                        <dt>{labels.work.client}</dt>
                        <dd>{project.client}</dd>
                      </>
                    )}
                    {project.result && (
                      <>
                        <dt>{labels.work.result}</dt>
                        <dd>{project.result}</dd>
                      </>
                    )}
                    {project.stack && (
                      <>
                        <dt>{labels.common.stack}</dt>
                        <dd class="case__stack">{project.stack}</dd>
                      </>
                    )}
                  </dl>
                )}
              </div>
            </div>
          </article>
        </li>
      ))
    }
  </ul>

  <ContactStrip locale={locale} site={site} labels={labels} closing={page.closing} ruled />

  <Lightbox slot="after-main" labels={labels} />
</BaseLayout>

<script>
  // The filter buttons ship hidden and appear once this script runs.
  // They show or hide the project rows by category and renumber the visible ones.
  const bar = document.querySelector<HTMLElement>('[data-filters]')
  const rows = document.querySelectorAll<HTMLElement>('[data-category]')

  if (bar && rows.length) {
    const buttons = bar.querySelectorAll<HTMLElement>('[data-filter]')
    bar.hidden = false

    bar.addEventListener('click', (event) => {
      const chosen = (event.target as Element).closest<HTMLElement>('[data-filter]')
      if (!chosen) return

      for (const button of buttons) {
        button.setAttribute('aria-pressed', String(button === chosen))
      }

      let visible = 0
      for (const row of rows) {
        const show = chosen.dataset.filter === 'all' || row.dataset.category === chosen.dataset.filter
        row.hidden = !show
        if (show) row.querySelector('[data-index]')!.textContent = String(++visible).padStart(2, '0')
      }
    })
  }
</script>
