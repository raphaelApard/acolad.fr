---
import { pathFor, type Locale } from '../lib/routes'
import type { Labels } from '../lib/types'

interface Props {
  locale: Locale
  labels: Labels
  title: string
  subtitle?: string | null
  /** Wider introduction paragraph (background page). */
  wide?: boolean
}

const { locale, labels, title, subtitle, wide = false } = Astro.props
---

<header class="page-head">
  <p class="page-head__back">
    <a href={pathFor('home', locale)}><span aria-hidden="true">←</span> {labels.nav.home}</a>
  </p>
  <div class="page-head__main">
    <h1 class="page-head__title">{title}</h1>
    {subtitle && <p class:list={['page-head__sub', { 'page-head__sub--wide': wide }]}>{subtitle}</p>}
  </div>
</header>
