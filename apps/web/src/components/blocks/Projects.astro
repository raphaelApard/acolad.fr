---
import { getDocs, resolveMedia } from '../../lib/cms'
import type { PageContext } from '../../lib/context'
import { headingId } from '../../lib/context'
import { pathOfRelation, type Block } from '../../lib/pages'
import ProjectMedia from '../ProjectMedia.astro'

interface Props {
  block: Block<'projects'>
  ctx: PageContext
  index: number
}

const { block, ctx, index } = Astro.props
const { locale, labels, pages } = ctx

const projects = await getDocs('projects', locale, 1)
const number = (position: number) => String(position + 1).padStart(2, '0')
const title = headingId(block, index)
const filters = [
  { value: 'all', label: labels.work.filterAll },
  { value: 'web', label: labels.work.filterWeb },
  { value: 'ia', label: labels.work.filterAi },
]
---

{
  block.variant === 'summary' ? (
    <section id={block.anchor} class="section" aria-labelledby={title}>
      <h2 id={title} class="section__label">
        {block.number && <span aria-hidden="true">{block.number} — </span>}
        {block.label}
      </h2>
      <div class="section__body">
        <ul class="projects">
          {projects
            .filter((project) => project.showOnHome)
            .map((project) => (
              <li>
                <article class="project">
                  <ProjectMedia media={resolveMedia(project.image)} labels={labels} />
                  <div class="project__text">
                    <p class="project__tag">{project.tag}</p>
                    <h3 class="project__title">{project.title}</h3>
                    <p class="project__desc">{project.shortDesc}</p>
                  </div>
                </article>
              </li>
            ))}
        </ul>
        <p class="more-wrap">
          <a class="more" href={pathOfRelation(pages, block.seeAll?.page, locale)}>
            {block.seeAll?.label} <span aria-hidden="true">→</span>
          </a>
        </p>
      </div>
    </section>
  ) : (
    <>
      <!-- Shown by the script below: without JavaScript every project stays visible and there is nothing to filter. -->
      <div class="filters" role="group" aria-labelledby="filters-label" data-filters hidden>
        <span id="filters-label" class="filters__label">
          {labels.work.filter}
        </span>
        {filters.map((filter) => (
          <button
            type="button"
            class="filter"
            data-filter={filter.value}
            aria-pressed={filter.value === 'all' ? 'true' : 'false'}
          >
            {filter.label}
          </button>
        ))}
      </div>

      <ul class="cases">
        {projects.map((project, position) => (
          <li data-category={project.category}>
            <article class="case">
              <p class="case__meta">
                <span data-index>{number(position)}</span>
                <br />
                {project.year && (
                  <>
                    {project.year}
                    <br />
                  </>
                )}
                {project.tag}
              </p>
              <div class="case__body">
                <ProjectMedia media={resolveMedia(project.image)} labels={labels} class="case__media" />
                <div class="case__text">
                  <h2 class="case__title">{project.title}</h2>
                  <p class="case__desc">{project.longDesc}</p>
                  {(project.client || project.result || project.stack) && (
                    <dl class="case__facts">
                      {project.client && (
                        <>
                          <dt>{labels.work.client}</dt>
                          <dd>{project.client}</dd>
                        </>
                      )}
                      {project.result && (
                        <>
                          <dt>{labels.work.result}</dt>
                          <dd>{project.result}</dd>
                        </>
                      )}
                      {project.stack && (
                        <>
                          <dt>{labels.common.stack}</dt>
                          <dd class="case__stack">{project.stack}</dd>
                        </>
                      )}
                    </dl>
                  )}
                </div>
              </div>
            </article>
          </li>
        ))}
      </ul>
    </>
  )
}

<script>
  // The filter buttons ship hidden and appear once this script runs.
  // They show or hide the project rows by category and renumber the visible ones.
  const bar = document.querySelector<HTMLElement>('[data-filters]')
  const rows = document.querySelectorAll<HTMLElement>('[data-category]')

  if (bar && rows.length) {
    const buttons = bar.querySelectorAll<HTMLElement>('[data-filter]')
    bar.hidden = false

    bar.addEventListener('click', (event) => {
      const chosen = (event.target as Element).closest<HTMLElement>('[data-filter]')
      if (!chosen) return

      for (const button of buttons) {
        button.setAttribute('aria-pressed', String(button === chosen))
      }

      let visible = 0
      for (const row of rows) {
        const show = chosen.dataset.filter === 'all' || row.dataset.category === chosen.dataset.filter
        row.hidden = !show
        if (show) row.querySelector('[data-index]')!.textContent = String(++visible).padStart(2, '0')
      }
    })
  }
</script>
