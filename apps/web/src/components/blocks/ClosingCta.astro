---
import type { PageContext } from '../../lib/context'
import { pathOfRelation, type Block } from '../../lib/pages'

interface Props {
  block: Block<'closingCta'>
  ctx: PageContext
  index: number
}

const { block, ctx, index } = Astro.props
const { locale, site, labels, pages, current, sections } = ctx

const href = block.target === 'mailto' ? `mailto:${site.email}` : pathOfRelation(pages, block.page, locale)
const year = new Date().getFullYear()
// The home page closes with a full-size block, the other pages with a compact one.
// A rule separates it from a list of case studies, which has no bottom border of its own.
const ruled = sections[index - 1]?.blockType === 'projects' && (sections[index - 1] as Block<'projects'>).variant === 'cases'
---

<section
  id="contact"
  class:list={['contact', { 'contact--compact': !current.isHome, 'contact--ruled': ruled }]}
  aria-labelledby="contact-title"
>
  <div class="contact__main">
    <h2 id="contact-title" class="contact__title">{block.title}</h2>
    <p class="contact__cta">
      <a href={href} class="btn btn--primary btn--large">{labels.common.contactButton}</a>
    </p>
  </div>
  <address class="contact__info">
    <p>© {year} {site.copyrightHolder}</p>
    <p>{site.location}</p>
    <ul class="socials" aria-label={labels.a11y.socials}>
      {
        (site.socials ?? []).map((social) => (
          <li>
            <a href={social.url} target="_blank" rel="noopener noreferrer me">
              {social.label}
            </a>
          </li>
        ))
      }
    </ul>
  </address>
</section>
