---
import { getDocs } from '../../lib/cms'
import type { PageContext } from '../../lib/context'
import { headingId } from '../../lib/context'
import type { Block } from '../../lib/pages'
import Chips from '../Chips.astro'

interface Props {
  block: Block<'stackGroups'>
  ctx: PageContext
  index: number
}

const { block, ctx, index } = Astro.props
const skillGroups = await getDocs('skill-groups', ctx.locale)
const title = headingId(block, index)
---

<section class="section section--tight" aria-labelledby={title}>
  <h2 id={title} class="section__label">{block.title}</h2>
  <div class="section__body stack-groups">
    {
      skillGroups.map((group) => (
        <div class="stack-group">
          <h3 class="stack-group__name">{group.title}</h3>
          <Chips items={group.skills ?? []} />
        </div>
      ))
    }
  </div>
</section>
