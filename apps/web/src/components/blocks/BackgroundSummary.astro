---
import { getDocs } from '../../lib/cms'
import type { PageContext } from '../../lib/context'
import { headingId } from '../../lib/context'
import { pathOfRelation, type Block } from '../../lib/pages'
import Chips from '../Chips.astro'

interface Props {
  block: Block<'backgroundSummary'>
  ctx: PageContext
  index: number
}

const { block, ctx, index } = Astro.props
const { locale, labels, pages } = ctx

const [jobs, skillGroups] = await Promise.all([getDocs('jobs', locale), getDocs('skill-groups', locale)])
const skills = skillGroups.flatMap((group) => group.skills ?? [])
const title = headingId(block, index)
---

<section id={block.anchor} class="section" aria-labelledby={title}>
  <h2 id={title} class="section__label">
    {block.number && <span aria-hidden="true">{block.number} — </span>}
    {block.label}
  </h2>
  <div class="section__body background">
    <div>
      <ol>
        {
          jobs
            .filter((job) => job.showOnHome)
            .map((job) => (
              <li class="entry">
                <span class="entry__years">{job.years}</span>
                <div>
                  <h3 class="entry__role">{job.role}</h3>
                  <p class="entry__org">{job.org}</p>
                </div>
              </li>
            ))
        }
      </ol>
      <p class="more-wrap more-wrap--ruled">
        <a class="more" href={pathOfRelation(pages, block.seeAll?.page, locale)}>
          {block.seeAll?.label} <span aria-hidden="true">→</span>
        </a>
      </p>
    </div>
    <div>
      <h3 class="stack__label">{labels.common.stack}</h3>
      <Chips items={skills} />
    </div>
  </div>
</section>
