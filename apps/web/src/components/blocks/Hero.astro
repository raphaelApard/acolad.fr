---
import type { PageContext } from '../../lib/context'
import type { Block } from '../../lib/pages'

interface Props {
  block: Block<'hero'>
  ctx: PageContext
  index: number
}

const { block } = Astro.props
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero__main">
    <h1 id="hero-title" class="hero__title">{block.title}</h1>
    <p class="hero__sub">{block.subtitle}</p>
    <div class="hero__ctas">
      <a href={block.primaryCta.href} class="btn btn--primary">{block.primaryCta.label}</a>
      <a href={block.secondaryCta.href} class="btn btn--outline">{block.secondaryCta.label}</a>
    </div>
  </div>
  <ul class="hero__aside">
    {(block.aside ?? []).map((line) => <li>{line.text}</li>)}
  </ul>
</section>
