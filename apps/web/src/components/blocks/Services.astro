---
import { getDocs } from '../../lib/cms'
import type { PageContext } from '../../lib/context'
import { headingId } from '../../lib/context'
import { pathOfRelation, type Block } from '../../lib/pages'
import Chips from '../Chips.astro'

interface Props {
  block: Block<'services'>
  ctx: PageContext
  index: number
}

const { block, ctx, index } = Astro.props
const { locale, labels, pages } = ctx

const services = await getDocs('services', locale)
const number = (position: number) => String(position + 1).padStart(2, '0')
const title = headingId(block, index)
---

{
  block.variant === 'summary' ? (
    <section id={block.anchor} class="section" aria-labelledby={title}>
      <h2 id={title} class="section__label">
        {block.number && <span aria-hidden="true">{block.number} — </span>}
        {block.label}
      </h2>
      <div class="section__body">
        <ol class="services">
          {services.map((service, position) => (
            <li class="service">
              <span class="service__number" aria-hidden="true">
                {number(position)}
              </span>
              <h3 class="service__title">{service.title}</h3>
              <p class="service__desc">{service.shortDesc}</p>
            </li>
          ))}
        </ol>
        <p class="more-wrap more-wrap--ruled">
          <a class="more" href={pathOfRelation(pages, block.seeAll?.page, locale)}>
            {block.seeAll?.label} <span aria-hidden="true">→</span>
          </a>
        </p>
      </div>
    </section>
  ) : (
    <div class="offers">
      {services.map((service, position) => (
        <section id={service.anchor} class="offer" aria-labelledby={`${service.anchor}-title`}>
          <p class="offer__number">{number(position)}</p>
          <div class="offer__body">
            <div class="offer__intro">
              <h2 id={`${service.anchor}-title`} class="offer__title">
                {service.title}
              </h2>
              <p class="offer__desc">{service.longDesc}</p>
            </div>
            <div class="offer__details">
              <div>
                <h3 class="label">{labels.common.deliverables}</h3>
                <ul class="deliverables">{(service.deliverables ?? []).map((item) => <li>{item.text}</li>)}</ul>
              </div>
              <div>
                <h3 class="label">{labels.common.stack}</h3>
                <Chips items={service.stack ?? []} />
              </div>
            </div>
          </div>
        </section>
      ))}
    </div>
  )
}
