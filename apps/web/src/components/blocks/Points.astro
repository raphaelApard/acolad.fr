---
import type { PageContext } from '../../lib/context'
import { headingId } from '../../lib/context'
import type { Block } from '../../lib/pages'

interface Props {
  block: Block<'points'>
  ctx: PageContext
  index: number
}

const { block, index } = Astro.props
const title = headingId(block, index)
const items = block.items ?? []
const Tag = block.numbered ? 'ol' : 'ul'
---

<section class="section section--tight" aria-labelledby={title}>
  <h2 id={title} class="section__label">{block.title}</h2>
  <Tag class:list={['section__body', 'points', { 'points--wide': block.wide }]}>
    {
      items.map((item, position) => (
        <li class="point">
          {block.numbered && <p class="point__number">{String(position + 1).padStart(2, '0')}</p>}
          <h3 class="point__title">{item.title}</h3>
          <p class="point__desc">{item.description}</p>
        </li>
      ))
    }
  </Tag>
</section>
