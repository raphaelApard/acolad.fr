---
import { getDocs } from '../../lib/cms'
import type { PageContext } from '../../lib/context'
import { headingId } from '../../lib/context'
import type { Block } from '../../lib/pages'

interface Props {
  block: Block<'experience'>
  ctx: PageContext
  index: number
}

const { block, ctx, index } = Astro.props
const jobs = await getDocs('jobs', ctx.locale)
const title = headingId(block, index)
---

<section class="section section--tight" aria-labelledby={title}>
  <h2 id={title} class="section__label">{block.title}</h2>
  <ol class="section__body jobs">
    {
      jobs.map((job) => (
        <li class="job">
          <p class="job__years">{job.years}</p>
          <div class="job__main">
            <h3 class="job__role">{job.role}</h3>
            <p class="job__org">{job.org}</p>
          </div>
          <p class="job__desc">{job.description}</p>
        </li>
      ))
    }
  </ol>
</section>
