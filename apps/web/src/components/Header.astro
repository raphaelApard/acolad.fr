---
import type { PageContext } from '../lib/context'
import { homeOf, navPagesOf } from '../lib/pages'
import { LOCALES } from '../lib/routes'

interface Props {
  ctx: PageContext
}

const { locale, current, site, labels, pages } = Astro.props.ctx

const navPages = navPagesOf(pages)
const items = navPages.map((page) => ({
  href: page.paths[locale],
  label: page.navLabel[locale],
  current: page.id === current.id,
}))

// On the home page the mobile menu scrolls to the section that summarises each page, when there is one.
const mobileItems = current.isHome
  ? navPages.map((page) => ({
      href: page.homeAnchor ? `#${page.homeAnchor}` : page.paths[locale],
      label: page.navLabel[locale],
      current: false,
    }))
  : items
---

<header class="site-header">
  <div class="site-header__bar">
    <a href={homeOf(pages).paths[locale]} class="brand">{site.name}</a>

    <nav class="site-nav" aria-label={labels.a11y.mainNavigation}>
      <ul>
        {
          items.map((item) => (
            <li>
              <a href={item.href} aria-current={item.current ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <ul class="langs" aria-label={labels.a11y.language}>
      {
        LOCALES.map((code) => (
          <li>
            <a
              class="lang"
              href={current.paths[code]}
              hreflang={code}
              lang={code}
              aria-current={code === locale ? 'page' : undefined}
            >
              {code.toUpperCase()}
            </a>
          </li>
        ))
      }
    </ul>

    <button type="button" class="menu-button" popovertarget="mobile-menu" aria-label={labels.a11y.menu}>
      <span class="menu-bar"></span>
      <span class="menu-bar"></span>
    </button>
  </div>

  <nav id="mobile-menu" class="mobile-nav" popover aria-label={labels.a11y.mainNavigation}>
    <ul>
      {
        mobileItems.map((item) => (
          <li>
            <a href={item.href} aria-current={item.current ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<script>
  // The mobile menu is a native popover opened by its button without any JavaScript.
  // This only closes it once a link is chosen.
  const menu = document.getElementById('mobile-menu')
  if (menu && typeof menu.hidePopover === 'function') {
    menu.addEventListener('click', (event) => {
      if ((event.target as Element).closest('a')) menu.hidePopover()
    })
  }
</script>
