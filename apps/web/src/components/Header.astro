---
import { LOCALES, NAV_KEYS, pathFor, type Locale, type NavKey, type PageKey } from '../lib/routes'
import type { Labels, Site } from '../lib/types'

interface Props {
  locale: Locale
  pageKey: PageKey
  site: Site
  labels: Labels
}

const { locale, pageKey, site, labels } = Astro.props

const items = NAV_KEYS.map((key) => ({
  href: pathFor(key, locale),
  label: labels.nav[key],
  current: key === pageKey,
}))

// On the home page the mobile menu scrolls to the sections of the page itself.
const sectionAnchors: Record<NavKey, string> = {
  services: '#services',
  work: '#projets',
  clients: '#clients',
  background: '#parcours',
  contact: '#contact',
}
const mobileItems =
  pageKey === 'home'
    ? NAV_KEYS.map((key, i) => ({ ...items[i], href: sectionAnchors[key], current: false }))
    : items
---

<header class="site-header">
  <div class="site-header__bar">
    <a href={pathFor('home', locale)} class="brand">{site.name}</a>

    <nav class="site-nav" aria-label={labels.a11y.mainNavigation}>
      <ul>
        {
          items.map((item) => (
            <li>
              <a href={item.href} aria-current={item.current ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <ul class="langs" aria-label={labels.a11y.language}>
      {
        LOCALES.map((code) => (
          <li>
            <a
              class="lang"
              href={pathFor(pageKey, code)}
              hreflang={code}
              lang={code}
              aria-current={code === locale ? 'page' : undefined}
            >
              {code.toUpperCase()}
            </a>
          </li>
        ))
      }
    </ul>

    <button type="button" class="menu-button" popovertarget="mobile-menu" aria-label={labels.a11y.menu}>
      <span class="menu-bar"></span>
      <span class="menu-bar"></span>
    </button>
  </div>

  <nav id="mobile-menu" class="mobile-nav" popover aria-label={labels.a11y.mainNavigation}>
    <ul>
      {
        mobileItems.map((item) => (
          <li>
            <a href={item.href} aria-current={item.current ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<script>
  // The mobile menu is a native popover opened by its button without any JavaScript.
  // This only closes it once a link is chosen.
  const menu = document.getElementById('mobile-menu')
  if (menu && typeof menu.hidePopover === 'function') {
    menu.addEventListener('click', (event) => {
      if ((event.target as Element).closest('a')) menu.hidePopover()
    })
  }
</script>
