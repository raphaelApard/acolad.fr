---
import { Picture } from 'astro:assets'

import { mediaUrl } from '../lib/cms'
import { srcsetWidths } from '../lib/images'
import type { Media } from '../lib/types'

interface Props {
  media: Media
  sizes: string
  /** Defaults to the alternative text set on the media in the CMS. */
  alt?: string
  class?: string
  loading?: 'lazy' | 'eager'
  /** Served to browsers without WebP: png keeps transparency (logos), jpeg is lighter (screenshots). */
  fallback?: 'png' | 'jpeg'
}

const {
  media,
  sizes,
  alt = media.alt ?? '',
  class: className,
  loading = 'lazy',
  fallback = 'jpeg',
} = Astro.props

const { width, height } = media
if (!width || !height) throw new Error(`The media "${media.filename}" has no dimensions.`)
---

<Picture
  src={mediaUrl(media)}
  alt={alt}
  width={width}
  height={height}
  widths={srcsetWidths(width)}
  sizes={sizes}
  formats={['webp']}
  fallbackFormat={fallback}
  quality={80}
  class={className}
  loading={loading}
  decoding="async"
/>
