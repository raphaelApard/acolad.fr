---
import { getImage } from 'astro:assets'

import { mediaUrl } from '../lib/cms'
import { LIGHTBOX_MAX_WIDTH, PROJECT_SIZES } from '../lib/images'
import type { Labels, Media } from '../lib/types'
import MediaImage from './MediaImage.astro'

interface Props {
  media: Media
  labels: Labels
  class?: string
}

const { media, labels, class: className } = Astro.props

// The lightbox shows the screenshot whole: generate its largest WebP now and hand the URL over.
const width = Math.min(media.width!, LIGHTBOX_MAX_WIDTH)
const full = await getImage({
  src: mediaUrl(media),
  width,
  height: Math.round((width * media.height!) / media.width!),
  format: 'webp',
  quality: 80,
})
---

<button
  class:list={['project__media', className]}
  type="button"
  data-lightbox
  data-full={full.src}
  aria-label={labels.lightbox.open}
>
  <MediaImage media={media} sizes={PROJECT_SIZES} class="project__img" />
</button>
