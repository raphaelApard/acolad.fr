---
import { pathFor, type Locale } from '../lib/routes'
import type { Labels, Site } from '../lib/types'

interface Props {
  locale: Locale
  site: Site
  labels: Labels
  /** Closing call to action of the page: its title and where the button leads. */
  closing: { title: string; target: 'contact' | 'mailto' }
  /** Home page: full-size block; other pages: compact block. */
  compact?: boolean
  /** Adds a rule above the block (projects page). */
  ruled?: boolean
}

const { locale, site, labels, closing, compact = true, ruled = false } = Astro.props

const href = closing.target === 'mailto' ? `mailto:${site.email}` : pathFor('contact', locale)
const year = new Date().getFullYear()
---

<section
  id="contact"
  class:list={['contact', { 'contact--compact': compact, 'contact--ruled': ruled }]}
  aria-labelledby="contact-title"
>
  <div class="contact__main">
    <h2 id="contact-title" class="contact__title">{closing.title}</h2>
    <p class="contact__cta">
      <a href={href} class="btn btn--primary btn--large">{labels.common.contactButton}</a>
    </p>
  </div>
  <address class="contact__info">
    <p>© {year} {site.copyrightHolder}</p>
    <p>{site.location}</p>
    <ul class="socials" aria-label={labels.a11y.socials}>
      {
        (site.socials ?? []).map((social) => (
          <li>
            <a href={social.url} target="_blank" rel="noopener noreferrer me">
              {social.label}
            </a>
          </li>
        ))
      }
    </ul>
  </address>
</section>
