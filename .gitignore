# Plain HTML/CSS/JS site: every site file is tracked (including .htaccess).
# Only local, generated or secret files are listed here.

# --- Operating systems -------------------------------------------------------
.DS_Store
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
*~

# --- Editors / IDEs ----------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# --- Secrets & local configuration -------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key

# --- Logs, caches & temporary files ------------------------------------------
*.log
.cache/
tmp/
temp/

# --- Build output (generated by `pnpm build`, uploaded to the server) --------
/dist/

# --- Local tooling (e.g. `npx serve`, Lighthouse reports) --------------------
node_modules/
lighthouse-report*.html
lighthouse-report*.json
*.lighthouse.*

# --- Deployment archives (zip the site to upload, but don't commit it) -------
*.zip
*.tar.gz

# --- Leftovers from the Next.js version on `main` when switching branches ----
/.next/
/out/
/.vercel/
next-env.d.ts
*.tsbuildinfo
