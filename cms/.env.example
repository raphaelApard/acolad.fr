# Copy to .env and adjust. Never commit the real file.

# Long random string (openssl rand -hex 32).
PAYLOAD_SECRET=change-me
# SQLite file. In production, put it outside the app folder, e.g. file:/home/<user>/cms-data/cms.db
DATABASE_URI=file:./data/cms.db
# Uploaded images. Defaults to cms/media; in production, next to the database.
MEDIA_DIR=
# Public URL of this CMS (admin links, e-mails, and where `pnpm content:pull` reads from).
CMS_URL=http://localhost:3000

# "Publish the site" button: the command it runs (defaults to ../scripts/publish.sh) and
# the folder the built site is copied to (the domain's document root on the server).
PUBLISH_COMMAND=
WEB_ROOT=

# E-mails (password reset). o2switch: use a mailbox created in cPanel, e.g. host mail.acolad.fr,
# port 465 with SMTP_SECURE=true. Without SMTP_HOST, e-mails are only written to the log.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@acolad.fr

# Optional, used by `pnpm seed` to create the first admin user on an empty CMS.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
